<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Three Address Code Generator</title>

    <link rel="stylesheet" href="style.css">
</head>
<body>

    <div class="container">
        <h1>Three Address Code Generator</h1>
        <p>Compiler Design Project</p>

        <label for="expression">Enter Expression:</label>

        <input
            type="text"
            id="expression"
            placeholder="Example: a = b + c * d"
        >

        <button onclick="generateTAC()">Generate TAC</button>
        <button onclick="clearAll()">Clear</button>

        <h2>Three Address Code Output</h2>

        <pre id="output">Your output will appear here.</pre>
    </div>

    <script src="script.js"></script>
</body>
</html>
